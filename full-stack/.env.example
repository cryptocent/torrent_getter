# Local .env is gitignored. NEVER put SMB passwords here.
PUID=1000
PGID=1000
TZ=Australia/Melbourne
HOST_BIND_IP=127.0.0.1
TORRENT_BIND_IP=0.0.0.0
TORRENT_PORT=6881
CONFIG_ROOT=./config
# Permanent LOCAL mount parent, with optional automounted 4tb and 5tb below.
# Configure using: bash full-stack/setup-network-shares.sh
NETWORK_ROOT=/mnt/media-shares
RSS_FEED_LIMIT=500

# FastChannels: 1=check public-IP geography (default), 0=hide warning only.
# Disabling this check does NOT remove geographic streaming restrictions.
GEO_CHECK_ENABLED=1
